# Copy to .env and fill with REAL values. NEVER commit .env (it's gitignored).
# Rotate any key that was ever pasted into a shared file or chat.

# LLM (reconstruct + QA) — your OpenRouter key
OPENROUTER_API_KEY=

# Render — LOCAL headless Chrome (free, unlimited). Point CHROME_PATH at the browser binary.
#   VPS (Debian/Ubuntu):  apt-get install -y chromium  → /usr/bin/chromium
#   or install Google Chrome → /usr/bin/google-chrome
CHROME_PATH=/usr/bin/chromium

# Supabase (stores the image + the static_ads row) — service_role key
SUPABASE_URL=https://xakngjsybyytldyqfsmi.supabase.co
SUPABASE_SERVICE_KEY=
BUCKET=static-ads

# Tuning
MODEL_BUILD=anthropic/claude-opus-4.8      # reconstruct — a strong model is required for quality
MODEL_VISION=anthropic/claude-sonnet-4.5   # QA scoring
THINK=high                                 # extended-thinking effort for reconstruct
MAX_TRIES=3                                # retries per template
SHIP_SCORE=7                               # QA score (1-10) an ad must clear to ship (below = dropped)
CONCURRENCY=3                              # templates in parallel

# Server
PORT=8787
WEBHOOK_TOKEN=                             # optional shared secret; callers send x-webhook-token
