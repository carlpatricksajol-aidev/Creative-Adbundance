# Third-party skill repos cloned locally — kept on disk, not tracked in this project
external-skills/

# VideoEditor: media + heavy artifacts stay on disk, not tracked
VideoEditor/input/
VideoEditor/work/
VideoEditor/output/
VideoEditor/assets/broll/
VideoEditor/assets/music/
VideoEditor/bin/
VideoEditor/node_modules/
VideoEditor/.venv/
VideoEditor/.env
VideoEditor/.secrets*

# Python cache
__pycache__/
*.pyc

# MaxFusion API: secret key + fetched spec stay local, never tracked
.maxfusion.env
maxfusion-openapi.json

# Node dependencies — never tracked, regenerated from package.json
node_modules/

# Heavy media stays on disk, not tracked (matches VideoEditor convention)
*.mp4
*.mov
*.webm

# CONFIDENTIAL CLIENT DATA — this repo is PUBLIC.
# Brand Brain harvest holds 50 clients' Creative Brief internals: positioning, personas,
# competitor lists, compliance notes, CAC targets. Never publish these.
Docs/Static Ads Generator/brand-brain-harvest/
Docs/Static Ads Generator/workflow-updates/brand_brain_migration.sql
Docs/Static Ads Generator/workflow-updates/brand_brain_sql/
*.mkv

# Local secret files, wherever they live
.env
.env.*
*.secret
*.secrets*

# MEETING TOOL — this repo is PUBLIC and meeting audio/transcripts are the most sensitive
# data the agency holds (client pricing, complaints, staffing, legal). The durable copies live
# in the private Supabase bucket; `work/` is local scratch that must never be committed.
MeetingTool/work/
MeetingTool/node_modules/
MeetingTool/*.changeset.json
# Google credentials: refresh tokens read a person's whole Drive, and a service-account key
# reads the entire domain's. Neither ever goes near a public repo.
MeetingTool/google-tokens.json
MeetingTool/sa-key.json
MeetingTool/*-key.json

# Internal system map: infra detail + client status, never publish to the public repo
Docs/Ecosystem/
# Stray exports of the ecosystem map that landed outside the folder (e.g. botched filenames)
Docs/Ecosystem*.pdf
Docs/Ecosystem*.html
Docs/Ecosystem*.docx

# CLIENT CREATIVE — this repo is PUBLIC. The client-view snapshots name ThreadBeast and
# ARMRA outright and embed 78 of ARMRA's delivered ad images plus ThreadBeast brand
# guidelines. Kept on disk to work from, never published from here.
Docs/AdBundance OS client view/

# Deck builder deps, installed per machine (see the skill's RUNBOOK.md)
.claude/skills/ad-concept-generator/scripts/node_modules/
.claude/skills/ad-concept-generator/scripts/package-lock.json
.claude/skills/ad-concept-generator/**/*.pptx
concept-service/.env
concept-service/data/
concept-service/.testdata/

# agent skills installed by npx skills (vendor content, not project code)
.agents/
