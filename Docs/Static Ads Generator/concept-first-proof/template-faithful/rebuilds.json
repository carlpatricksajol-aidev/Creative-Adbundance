ify-content:space-between;margin-bottom:9px\">\n          <div style=\"display:flex;align-items:center;gap:7px;background:#0c0e14;border-radius:9px;padding:6px 9px\">\n            <span style=\"width:22px;height:22px;border-radius:6px;background:var(--blue);display:inline-flex;align-items:center;justify-content:center\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:13px;height:13px\"><path d=\"M4 16l4.5-5 3.5 3L20 6\"/><path d=\"M20 10V6h-4\"/></svg></span>\n            <span style=\"font-size:8.5px;font-weight:800;color:#fff;line-height:1.05;letter-spacing:.02em\">TRADE WITH<br>THE <span style=\"color:#5C8BFF\">PROS</span></span>\n          </div>\n          <span style=\"font-size:8px;color:#888;text-align:right;line-height:1.3\">Live Trading Plan<br>06/10/25</span>\n        </div>\n        <table style=\"width:100%;border-collapse:collapse;font-size:8.5px;margin-bottom:9px\">\n          <tr><td style=\"border:1px solid #ececec;padding:3px 5px;color:#666\">Program</td><td style=\"border:1px solid #ececec;padding:3px 5px;font-weight:700;color:#111\">12 weeks</td><td style=\"border:1px solid #ececec;padding:3px 5px;color:#666\">Week in</td><td style=\"border:1px solid #ececec;padding:3px 5px;font-weight:700;color:#111\">3</td></tr>\n          <tr><td style=\"border:1px solid #ececec;padding:3px 5px;color:#666\">Mentor</td><td style=\"border:1px solid #ececec;padding:3px 5px;font-weight:700;color:#111\">Live floor</td><td style=\"border:1px solid #ececec;padding:3px 5px;color:#666\">Review</td><td style=\"border:1px solid #ececec;padding:3px 5px;font-weight:700;color:#111\">Mon 9a</td></tr>\n        </table>\n        <div style=\"border:1px solid #ececec;border-radius:8px;padding:7px 9px;margin-bottom:9px\">\n          <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:4px\">\n            <span style=\"font-size:8.5px;font-weight:700;color:#111\">Live screen time</span>\n            <span style=\"font-size:8px;color:var(--green);font-weight:700\">wk 1 &rarr; 12</span>\n          </div>\n          <svg viewBox=\"0 0 100 34\" fill=\"none\" stroke=\"var(--green)\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:100%;height:34px\"><path d=\"M4 30 L26 24 L44 26 L66 12 L96 5\"/></svg>\n        </div>\n        <div style=\"font-size:8.5px;font-weight:800;color:#111;margin-bottom:3px\">My setups &amp; rules</div>\n        <table style=\"width:100%;border-collapse:collapse;font-size:8.5px;color:#161616;margin-bottom:9px;table-layout:fixed\">\n          <tr style=\"background:#0c0e14;color:#fff;font-weight:700\"><td style=\"padding:3px 5px\">Setup</td><td style=\"padding:3px 5px\">Bias</td><td style=\"padding:3px 5px;text-align:center\">Set</td></tr>\n          <tr><td style=\"border:1px solid #ececec;padding:3px 5px\">Breakout retest</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Long</td><td style=\"border:1px solid #ececec;padding:3px 5px;text-align:center;color:var(--green)\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg></td></tr>\n          <tr><td style=\"border:1px solid #ececec;padding:3px 5px\">Trend pullback</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Long</td><td style=\"border:1px solid #ececec;padding:3px 5px;text-align:center;color:var(--green)\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg></td></tr>\n          <tr><td style=\"border:1px solid #ececec;padding:3px 5px\">Range fade</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Short</td><td style=\"border:1px solid #ececec;padding:3px 5px;text-align:center;color:var(--green)\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg></td></tr>\n          <tr><td style=\"border:1px solid #ececec;padding:3px 5px\">Risk / trade</td><td style=\"border:1px solid #ececec;padding:3px 5px\">1% max</td><td style=\"border:1px solid #ececec;padding:3px 5px;text-align:center;color:var(--green)\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg></td></tr>\n        </table>\n        <div style=\"font-size:8.5px;font-weight:800;color:#111;margin-bottom:3px\">This week at the center</div>\n        <table style=\"width:100%;border-collapse:collapse;font-size:8.5px;color:#161616;table-layout:fixed\">\n          <tr style=\"background:#eef2fb;color:#1E4FD6;font-weight:700\"><td style=\"border:1px solid #e0e6f2;padding:3px 5px\">Day</td><td style=\"border:1px solid #e0e6f2;padding:3px 5px\">Focus</td><td style=\"border:1px solid #e0e6f2;padding:3px 5px\">With</td></tr>\n          <tr><td style=\"border:1px solid #ececec;padding:3px 5px\">Mon</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Live floor</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Mentor</td></tr>\n          <tr><td style=\"border:1px solid #ececec;padding:3px 5px\">Tue</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Journal review</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Group</td></tr>\n          <tr><td style=\"border:1px solid #ececec;padding:3px 5px\">Wed</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Setups drill</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Mentor</td></tr>\n          <tr><td style=\"border:1px solid #ececec;padding:3px 5px\">Fri</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Weekly recap</td><td style=\"border:1px solid #ececec;padding:3px 5px\">Community</td></tr>\n        </table>\n      </div>\n    </div>\n  </div>\n\n</div>","css_extra":""},{"templateKey":"vsthem","html_body":"<div class=\"stage\" style=\"background:var(--paper); position:relative; overflow:hidden; font-family:'Manrope',sans-serif; padding:64px 62px; display:flex; flex-direction:column;\">\n\n  <!-- ===== ZONE A: comparison checklist ===== -->\n  <div style=\"display:flex; flex-direction:column;\">\n\n    <!-- column headers -->\n    <div style=\"display:grid; grid-template-columns:1fr 208px 232px; align-items:end; padding:0 0 18px;\">\n      <div></div>\n      <div style=\"text-align:center; font-weight:700; font-size:18px; line-height:1.15; letter-spacing:.11em; text-transform:uppercase; color:var(--sub);\">Online<br>course</div>\n      <div style=\"text-align:center; font-weight:800; font-size:18px; line-height:1.15; letter-spacing:.05em; text-transform:uppercase; color:var(--blue);\">Trade With<br>The Pros</div>\n    </div>\n\n    <!-- feature row 1 -->\n    <div style=\"display:grid; grid-template-columns:1fr 208px 232px; align-items:center; padding:36px 0; border-top:1.5px solid var(--line);\">\n      <div style=\"font-size:29px; font-weight:600; color:var(--ink);\">Live, in-person sessions</div>\n      <div style=\"display:flex; justify-content:center; color:var(--sub);\"><svg viewBox=\"0 0 24 24\" width=\"40\" height=\"40\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 7l10 10M17 7L7 17\"/></svg></div>\n      <div style=\"display:flex; justify-content:center; color:var(--blue);\"><svg viewBox=\"0 0 24 24\" width=\"42\" height=\"42\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg></div>\n    </div>\n\n    <!-- feature row 2 -->\n    <div style=\"display:grid; grid-template-columns:1fr 208px 232px; align-items:center; padding:36px 0; border-top:1.5px solid var(--line);\">\n      <div style=\"font-size:29px; font-weight:600; color:var(--ink);\">A mentor watching your trades</div>\n      <div style=\"display:flex; justify-content:center; color:var(--sub);\"><svg viewBox=\"0 0 24 24\" width=\"40\" height=\"40\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 7l10 10M17 7L7 17\"/></svg></div>\n      <div style=\"display:flex; justify-content:center; color:var(--blue);\"><svg viewBox=\"0 0 24 24\" width=\"42\" height=\"42\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg></div>\n    </div>\n\n    <!-- feature row 3 -->\n    <div style=\"display:grid; grid-template-columns:1fr 208px 232px; align-items:center; padding:36px 0; border-top:1.5px solid var(--line);\">\n      <div style=\"font-size:29px; font-weight:600; color:var(--ink);\">A real trading floor near you</div>\n      <div style=\"display:flex; justify-content:center; color:var(--sub);\"><svg viewBox=\"0 0 24 24\" width=\"40\" height=\"40\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 7l10 10M17 7L7 17\"/></svg></div>\n      <div style=\"display:flex; justify-content:center; color:var(--blue);\"><svg viewBox=\"0 0 24 24\" width=\"42\" height=\"42\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg></div>\n    </div>\n\n    <!-- feature row 4 -->\n    <div style=\"display:grid; grid-template-columns:1fr 208px 232px; align-items:center; padding:36px 0; border-top:1.5px solid var(--line);\">\n      <div style=\"font-size:29px; font-weight:600; color:var(--ink);\">A community that keeps you accountable</div>\n      <div style=\"display:flex; justify-content:center; color:var(--sub);\"><svg viewBox=\"0 0 24 24\" width=\"40\" height=\"40\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 7l10 10M17 7L7 17\"/></svg></div>\n      <div style=\"display:flex; justify-content:center; color:var(--blue);\"><svg viewBox=\"0 0 24 24\" width=\"42\" height=\"42\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg></div>\n    </div>\n\n    <!-- ===== ZONE B: value contrast row ===== -->\n    <div style=\"display:grid; grid-template-columns:1fr 208px 232px; align-items:center; padding:28px 0; border-top:1.5px solid var(--line); border-bottom:1.5px solid var(--line);\">\n      <div style=\"font-size:29px; font-weight:800; color:var(--ink);\">What you actually get</div>\n      <div style=\"text-align:center; font-size:22px; font-weight:700; line-height:1.12; color:var(--sub);\">Videos you<br>never finish</div>\n      <div style=\"text-align:center; font-size:28px; font-weight:800; line-height:1.08; letter-spacing:-.01em; color:var(--blue);\">Real screen<br>time</div>\n    </div>\n  </div>\n\n  <!-- ===== ZONE C + D: headline left / cards right ===== -->\n  <div style=\"display:grid; grid-template-columns:1fr 400px; gap:26px; align-items:end; padding-top:34px; position:relative;\">\n\n    <!-- curved arrow sweeping from the headline up to the \"Videos you never finish\" cell -->\n    <svg viewBox=\"0 0 440 210\" width=\"440\" height=\"210\" fill=\"none\" style=\"position:absolute; left:200px; top:-150px;\" stroke=\"var(--sub)\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" opacity=\"0.6\"><path d=\"M24 196 C 130 158, 320 122, 404 100\"/><path d=\"M386 86 L410 99 L392 118\"/></svg>\n\n    <!-- headline -->\n    <div style=\"font-weight:800; font-size:52px; line-height:1.05; text-transform:uppercase; letter-spacing:-.01em;\">\n      <span style=\"color:var(--ink);\">Are you<br>paying for</span><br>\n      <span style=\"color:var(--blue);\">videos you<br>never finish?</span>\n    </div>\n\n    <!-- two labeled cards -->\n    <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:18px; align-items:end;\">\n\n      <!-- muted card: another online course -->\n      <div>\n        <div style=\"text-align:center; font-weight:700; font-size:14px; letter-spacing:.05em; text-transform:uppercase; color:var(--sub); margin-bottom:12px; line-height:1.2;\">Another<br>online course</div>\n        <div style=\"height:184px; border-radius:20px; background:var(--light); border:1.5px solid var(--line); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; color:var(--sub);\">\n          <svg viewBox=\"0 0 24 24\" width=\"52\" height=\"52\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"7\" r=\"2.5\"/><circle cx=\"5.5\" cy=\"10.5\" r=\"2.1\"/><circle cx=\"18.5\" cy=\"10.5\" r=\"2.1\"/><path d=\"M8 20c0-2.3 1.8-4 4-4s4 1.7 4 4\"/></svg>\n          <div style=\"font-size:15px; font-weight:700; letter-spacing:.04em; text-transform:uppercase;\">Learn alone</div>\n        </div>\n      </div>\n\n      <!-- blue hero card: Trade With The Pros -->\n      <div>\n        <div style=\"text-align:center; font-weight:800; font-size:14px; letter-spacing:.05em; text-transform:uppercase; color:var(--blue); margin-bottom:12px; line-height:1.2;\">The real<br>thing</div>\n        <div style=\"height:184px; border-radius:20px; background:var(--blue); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:13px; color:#fff; box-shadow:0 18px 34px -18px rgba(46,107,255,.65);\">\n          <svg viewBox=\"0 0 24 24\" width=\"46\" height=\"46\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8.5\" cy=\"8\" r=\"2.6\"/><circle cx=\"16\" cy=\"9\" r=\"2.2\"/><path d=\"M4 19c0-2.8 2-4.6 4.5-4.6S13 16.2 13 19\"/><path d=\"M13.5 18.5c.2-2.2 1.6-3.6 3.5-3.6 2 0 3.4 1.5 3.5 3.9\"/></svg>\n          <div style=\"font-family:'Manrope',sans-serif; font-weight:800; font-size:20px; line-height:1.12; letter-spacing:.01em; text-align:center; color:#fff;\">Trade With The Pros</div>\n          <div style=\"font-size:14px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:rgba(255,255,255,.9);\">Mentored in person</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n</div>","css_extra":".stage .prod-wm .wm{font-size:20px;font-weight:700}\n.stage .wm-lock .wm b{color:#fff}"},{"templateKey":"notes","html_body":"<div class=\"stage\" style=\"position:relative;overflow:hidden;width:1080px;height:1080px;background:var(--paper);font-family:'Manrope',sans-serif;\">\n\n  <!-- ZONE 1: iOS status bar -->\n  <div style=\"position:absolute;top:38px;left:60px;right:60px;height:44px;display:flex;align-items:center;justify-content:space-between;\">\n    <div style=\"font-size:38px;font-weight:800;color:var(--ink);letter-spacing:-1px;font-variant-numeric:tabular-nums;\">9:23</div>\n    <div style=\"display:flex;align-items:center;gap:14px;\">\n      <!-- wifi -->\n      <svg width=\"40\" height=\"30\" viewBox=\"0 0 40 30\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"3.2\" stroke-linecap=\"round\"><path d=\"M4 11 C13 3 27 3 36 11\" /><path d=\"M10 17 C16 12 24 12 30 17\" /><path d=\"M16 23 C18 21 22 21 24 23\" /><circle cx=\"20\" cy=\"26\" r=\"0.6\" fill=\"var(--ink)\" stroke=\"none\"/></svg>\n      <!-- cellular signal bars -->\n      <svg width=\"40\" height=\"30\" viewBox=\"0 0 40 30\" fill=\"var(--ink)\"><rect x=\"2\" y=\"18\" width=\"6\" height=\"9\" rx=\"1.5\"/><rect x=\"12\" y=\"13\" width=\"6\" height=\"14\" rx=\"1.5\"/><rect x=\"22\" y=\"8\" width=\"6\" height=\"19\" rx=\"1.5\"/><rect x=\"32\" y=\"3\" width=\"6\" height=\"24\" rx=\"1.5\"/></svg>\n      <!-- battery -->\n      <svg width=\"56\" height=\"30\" viewBox=\"0 0 56 30\" fill=\"none\"><rect x=\"2\" y=\"6\" width=\"44\" height=\"20\" rx=\"6\" stroke=\"var(--ink)\" stroke-width=\"2.6\"/><rect x=\"6\" y=\"10\" width=\"30\" height=\"12\" rx=\"3\" fill=\"var(--ink)\"/><rect x=\"49\" y=\"12\" width=\"4\" height=\"8\" rx=\"2\" fill=\"var(--ink)\"/></svg>\n    </div>\n  </div>\n\n  <!-- ZONE 2: testimonial body -->\n  <div style=\"position:absolute;top:150px;left:60px;right:52px;font-size:50px;line-height:1.2;font-weight:800;color:#050608;letter-spacing:-0.8px;\">I spent two years watching trading videos alone at 2am and still blew up my account. Then I walked into a <span style=\"white-space:nowrap;\">Trade With</span> The Pros center. <span class=\"hl\">In six weeks I finally had a plan I could actually follow</span> and a room that calls out my bad trades before I take them. First green month I have had in two years, and I stopped trading scared.</div>\n\n  <!-- ZONE 3: proof artifact (lower-left) = P&L equity curve card -->\n  <div style=\"position:absolute;left:60px;bottom:70px;width:340px;height:250px;background:var(--light);border-radius:26px;border:1px solid var(--line);box-shadow:0 10px 30px rgba(10,16,32,.08);padding:22px 24px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between;\">\n    <div style=\"font-size:24px;font-weight:800;color:var(--sub);letter-spacing:-0.3px;\">my P&amp;L since</div>\n    <svg viewBox=\"0 0 100 60\" width=\"100%\" height=\"120\" fill=\"none\" stroke=\"var(--green)\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"overflow:visible;\"><path d=\"M4 52 L26 40 L44 46 L66 22 L96 8\"/><circle cx=\"96\" cy=\"8\" r=\"4.5\" fill=\"var(--green)\" stroke=\"none\"/></svg>\n    <div style=\"display:flex;align-items:center;gap:8px;color:var(--green);font-size:26px;font-weight:800;\">\n      <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg>\n      green + consistent\n    </div>\n  </div>\n\n  <!-- ZONE 4: hand-drawn red \"This\" + curved arrow (lower-right) -->\n  <svg style=\"position:absolute;right:24px;bottom:44px;\" width=\"560\" height=\"470\" viewBox=\"0 0 560 470\" fill=\"none\">\n    <!-- curved arrow sweeping up into the empty white gutter to the RIGHT of the paragraph -->\n    <g stroke=\"var(--red)\" stroke-width=\"11\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\">\n      <path d=\"M415 300 C 500 250, 455 175, 489 129\"/>\n      <path d=\"M489 129 L 462 150\"/>\n      <path d=\"M489 129 L 515 148\"/>\n    </g>\n    <!-- hand-lettered marker \"This\" -->\n    <g stroke=\"var(--red)\" stroke-width=\"15\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\">\n      <!-- T -->\n      <path d=\"M60 300 L 150 285\"/>\n      <path d=\"M108 288 L 96 400\"/>\n      <!-- h -->\n      <path d=\"M188 250 L 168 405\"/>\n      <path d=\"M170 330 C 200 300, 245 305, 236 350 L 228 405\"/>\n      <!-- i -->\n      <path d=\"M290 320 L 276 408\"/>\n      <circle cx=\"298\" cy=\"292\" r=\"4\" fill=\"var(--red)\" stroke=\"none\"/>\n      <!-- s -->\n      <path d=\"M405 322 C 375 305, 340 320, 368 345 C 396 370, 372 400, 335 392\"/>\n    </g>\n  </svg>\n\n</div>","css_extra":".hl{background:var(--yellow);-webkit-box-decoration-break:clone;box-decoration-break:clone;padding:2px 8px;border-radius:5px;}"}]