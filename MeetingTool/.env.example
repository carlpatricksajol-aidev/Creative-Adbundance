# Copy to .env and fill with REAL values. NEVER commit .env (it's gitignored).
# Rotate any key that was ever pasted into a shared file or chat — two OpenRouter keys from
# this repo have already been exposed.
#
#   cp .env.example .env
#
# Non-secret values are pre-filled; every blank is something you have to go and get.
# Order below is the order you need them in.


# ── 1. Google (capture) ──────────────────────────────────────────────────────
# Google Cloud → APIs & Services → enable "Google Drive API"
#              → OAuth consent screen → User type INTERNAL   ← not optional:
#                an app left in "Testing" issues refresh tokens that die after 7 days
#              → Credentials → OAuth client ID → Desktop app
# Then run `node auth-google.js` once per person who ORGANISES meetings (notes land in the
# organiser's Drive). That writes google-tokens.json next to this file.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Which speakers count as internal. A client's instruction outranks an internal person's
# speculation, and that rule is only as good as this line.
INTERNAL_DOMAIN=creativeadbundance.com

# Drive folder Meet writes to. Only change if your Workspace localises the name.
MEETING_FOLDER_NAME=Meet Recordings
# Display names that count as internal in Drive COMMENTS (the comments API exposes names, not
# emails). Everyone else is treated as a client reviewer. Same convention as the Figma digest.
INTERNAL_HANDLES=Carl Sajol,eric mann,Eric Mann,Kyle Fenerty,Ricardo Mestae,Joi Angeles,Volvo Ebal,Darshan Mangukiya,Xandria Heidrich,Dimple Hotchandani,Jake Tugz,Krithika Chandramouli,Janna Balisacan,Mikaela Mercado
# How far back the FIRST comments poll reaches (later polls continue from the cursor).
COMMENTS_LOOKBACK_DAYS=14

# Optional: poll only these people instead of everyone in google-tokens.json.
# GOOGLE_IMPERSONATE=carl@creativeadbundance.com,eric@creativeadbundance.com

# Optional fallback, only if your org ever allows service-account keys (yours currently
# blocks them via iam.disableServiceAccountKeyCreation — see ARCHITECTURE.md 3b).
# GOOGLE_SA_KEY_FILE=/root/meeting-tool/sa-key.json


# ── 2. Extraction ────────────────────────────────────────────────────────────
# The only model call in the system. Haiku is plenty for extraction and costs pennies per
# meeting; switch to sonnet for high-stakes client calls if the proposals feel thin.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5


# ── 3. Store (Supabase) ──────────────────────────────────────────────────────
# Run schema.sql on this project first. service_role key — server-only, bypasses RLS.
# It never reaches a browser: the dashboard talks to server.js, not Supabase.
SUPABASE_URL=https://xakngjsybyytldyqfsmi.supabase.co
SUPABASE_SERVICE_KEY=


# ── 4. Backends the tool writes to ───────────────────────────────────────────
# Brand Brain needs NO extra config — it is public.brand_brain in the Supabase project
# above, so SUPABASE_SERVICE_KEY covers it. (It used to be Airtable; that base hit
# PUBLIC_API_BILLING_LIMIT_EXCEEDED and the static-ads pipeline moved to Postgres.)
# Brand resolution reuses brand_brain.aliases — the same pipe-delimited column the ads
# pipeline matches on. If a spoken name does not resolve, add it there.

# OPTIONAL — leave both blank unless you have a real TASKS database.
# The only Notion DB this agency is known to run is "File Renaming Automation" (a per-job
# video production queue: Client's Name / Dropbox link / READY? / Status). That is not a task
# list — it has no Owner or Due — so pointing this at it would be wrong.
# Blank = action items and asset requests land in Supabase meeting_notes and show up in the
# dashboard and the Slack ping, same as decisions and blockers. Fill these in later if you
# decide tasks belong in Notion; it changes nothing else.
# Remember to SHARE the database with the integration in Notion, or every write 404s.
NOTION_TOKEN=
NOTION_TASKS_DB=
# Only set these if your database uses different property names than the defaults.
# NOTION_PROP_TITLE=Name
# NOTION_PROP_OWNER=Owner
# NOTION_PROP_DUE=Due
# NOTION_PROP_BRAND=Brand
# NOTION_PROP_STATUS=Status
# NOTION_DEFAULT_STATUS=Not started


# ── 5. Service ───────────────────────────────────────────────────────────────
# Long random shared secret. The dashboard and any ingest caller send it as a bearer token.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEETING_TOKEN=
PORT=8790

# Gates writes to OTHER systems of record only — brand_brain and Notion.
# Recording the meeting itself is always automatic and is NOT affected by this: every meeting,
# transcript, changeset and note is stored in Supabase either way. 0 just means nothing reaches
# a client's Brand Brain or your task list without a click. Flip to 1 once you have read a week
# of real changesets (ARCHITECTURE.md, Phase 3).
AUTO_APPLY=0

# Slack ping after each meeting. Import n8n/meeting-notify.workflow.json, activate it, then
# paste its production webhook URL here. Leave blank to skip notifications entirely.
N8N_NOTIFY_URL=

# Used to build the "review this" link in the Slack message.
# DASHBOARD_URL=https://meetings.srv1486031.hstgr.cloud


# ── 6. Extension fallback only ───────────────────────────────────────────────
# Not needed for Google Meet — Gemini already transcribes. These only matter if you fall
# back to the Chrome extension for a non-Meet call.
# WHISPER_PYTHON=/root/video-editor/.venv/bin/python
# WHISPER_MODEL=small.en
