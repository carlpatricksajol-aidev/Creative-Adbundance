# concept-service configuration.
#
#   cp .env.example .env
#
# .env is gitignored twice over and must stay that way: this repository is
# PUBLIC. Nothing in THIS file may ever hold a real value. A blank, or a public
# identifier like a project URL, and nothing else.
#
# Ask Carl for the values, out of band. See LOCAL.md for how to run it.
#
# Note for docker: docker-compose.yml sets PORT, DATA_DIR, the three SKILL_DIR
# paths and RESEARCH_AGENT_URL in its own environment block, and that block
# beats anything written here. The path settings below only take effect when
# you run `node src/server.js` yourself.

# ---------------------------------------------------------------------------
# 1. THE ONES YOU HAVE TO BE GIVEN
# ---------------------------------------------------------------------------

# Every model call goes through OpenRouter. Without it the service still boots
# and /health still answers, but every route that generates returns 503 before
# spending anything, and the boot line says the key is missing.
# This spends real money: one concept batch on Opus is a few dollars. Ask for
# your own key with its own cap rather than sharing the production one.
OPENROUTER_API_KEY=

# The Supabase project the client data lives in. This URL is a public
# identifier, not a secret.
SUPABASE_URL=https://xakngjsybyytldyqfsmi.supabase.co

# The read key for the five client tables. Every reader tries the service key
# first and falls back to the anon key, so setting either one works.
#
# Measured 2026-09-14, with the anon key alone:
#   brand_brain                   reads
#   marketing_report              reads
#   meeting_summary               reads
#   knowledge_v_concept_approved  200 with ZERO rows, hidden by row level security
#   knowledge_vehicle_bank        200 with ZERO rows, same
# So a batch still generates, with no approved concept library and no vehicle
# bank, and nothing in the output says so. If you are working on concept
# quality you need the service key. It bypasses row level security on the whole
# project, so treat it like a production password and keep it off any browser.
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# 2. THE ONES YOU SET YOURSELF
# ---------------------------------------------------------------------------

# The bearer token every route except /health and the sign-in routes requires.
# Make your own, do not reuse the server's:
#   openssl rand -hex 24
# Unset, the service boots, warns once, then answers 401 to everything, which
# looks like a broken install.
RUN_TOKEN=

# Where everything is written: runs, batches, scripts, storyboards, briefs, the
# OS page. Defaults to /data, which is right inside the container and wrong on
# a laptop. Six modules create this directory when they load, so an unwritable
# path kills the process before it ever listens.
DATA_DIR=./data

# The skills, read from disk on every call, so editing one changes the next run
# with no restart. These point back into this same clone, which already has all
# three. A wrong path does not fail at boot: the run starts, pays for a model
# call or two, then dies with "missing SKILL.md at ...".
SKILL_DIR=../.claude/skills/quick-concepts
SCRIPT_SKILL_DIR=../.claude/skills/ad-script-writer
STORY_SKILL_DIR=../.claude/skills/batch-shoot-package

# Browsers are refused from any origin not listed here. curl ignores CORS, so
# this only bites when you drive the service from a page on another port, and
# the server logs a clean 200 while the browser console shows the failure.
ALLOWED_ORIGINS=http://localhost:8900,http://127.0.0.1:8900

PORT=8900

# How many generations may run at once. One locally, so a double click cannot
# spend twice. The server runs two.
MAX_CONCURRENT=1

# ---------------------------------------------------------------------------
# 3. HAVE SENSIBLE DEFAULTS. Leave blank unless you know why.
# ---------------------------------------------------------------------------

# Any model slug the OpenRouter key can reach.
CONCEPT_MODEL=anthropic/claude-opus-5
# The reviewers and the parse that lifts written text into fields. Falls back
# to CONCEPT_MODEL. Point it at something cheap while iterating on a stage.
REVIEW_MODEL=
# Writes the image prompt for a mockup.
MOCKUP_MODEL=

# Set to v4 to fall back to the old two agent chain. Nothing else reads it.
CONCEPT_PIPELINE=

# Where a sibling skill is looked up from. Defaults to the parent of SKILL_DIR,
# which is correct for a normal .claude/skills tree.
SKILLS_ROOT=

# ---------------------------------------------------------------------------
# 4. ONE FEATURE EACH. All of these can stay blank on a laptop. None is touched
#    by a concept, script or storyboard run, and each says what it costs you.
# ---------------------------------------------------------------------------

# The shared vault on the server: the marketing report queue, the onboarding
# queue, and the mockup prompt. Defaults to /vault.
# LEAVE THIS BLANK LOCALLY. With no vault, commissioning a report fails
# immediately and the run carries on with what is already on file, which is
# what you want. If a <VAULT_ROOT>/system/queue directory exists with no runner
# watching it, the run waits the full timeout below instead.
VAULT_ROOT=

# How long a run waits for a commissioned marketing report. Default 15 minutes.
REPORT_TIMEOUT_MS=

# Mockups. KIE_API_KEY is paid image generation; without it the mockup routes
# return 503 and the board shows the reserved 9:16 space with a button, which
# is a designed state and not a break.
# Mockups cannot be reproduced on a laptop whatever you set here: the prompt
# they are written from, concept-visualizer.md, is deliberately not in this
# public repository. See scripts/sync-mockup-prompt.md.
KIE_API_KEY=
MOCKUP_PROMPT_DIR=

# The host side rasteriser that draws the story frame around a mockup. It runs
# only on the server. Without the token, framing fails with a named error
# before any network call, and the unframed still is still served.
FRAME_SERVICE_URL=
FRAME_SERVICE_TOKEN=

# Sign-in codes for the /os page. With no mail key the code is printed to the
# server console instead, which is how you sign in locally. MAIL_FROM does
# nothing without RESEND_API_KEY.
RESEND_API_KEY=
MAIL_FROM=

# The research agent that writes a client's marketing report. Without it the
# report step says it could not refresh and the run continues.
RESEARCH_AGENT_TOKEN=
RESEARCH_AGENT_URL=

# The footage renamer lives in n8n. Empty is a designed state: the job is
# recorded as queued and a person runs the renamer, which the page says.
# SELF_URL is the callback address handed to that webhook and it falls back to
# the PRODUCTION hostname, so leave both blank locally.
FOOTAGE_WEBHOOK_URL=
SELF_URL=

# The link a client is sent when work is pushed to them. Falls back to the
# production portal, so leave it blank unless you are testing that flow.
CLIENT_PORTAL_URL=

# Onboarding writes a new brand into the relational Knowledge Layer, a second
# Supabase project reached over Postgres rather than REST, and it is the only
# thing that still reads it: the generator stopped using that project on
# 2026-09-10 under the five table rule. Without it the onboarding form cannot
# save. This is a Postgres connection string, so it is a password.
SUPABASE_KNOWLEDGE_LAYER_URL=
